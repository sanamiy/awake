#!/bin/zsh -f
set -euo pipefail
readonly PKG_SCRIPT_DIR="${0:A:h}"
source "$PKG_SCRIPT_DIR/pkg-common.zsh"

preinstall_main() {
  pkg_step LA6001 pkg_require_root_and_volume "${3:-}" || return 1
  pkg_step LA6002 pkg_resolve_user || return 1
  pkg_step LA1002 pkg_require_app_stopped || return 1
  # Installer extracts this package's scripts together in a private directory.
  pkg_step LA6002 pkg_pin_user "$PKG_SCRIPT_DIR/install-target" || return 1
}

if [[ "$ZSH_EVAL_CONTEXT" == toplevel ]]; then preinstall_main "$@"; fi
